<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Gorm</AssemblyName>
    <PackageId>GORM</PackageId>
    <RootNamespace>Gorm</RootNamespace>
    <Authors>Pjotr Casteel</Authors>
    <Description>Strongly typed SQL Server Graph ORM for .NET with LINQ, graph tracking, mutations, history and in-memory execution.</Description>
    <PackageTags>graph;orm;sql-server;linq;dotnet;graph-database</PackageTags>
    <PackageProjectUrl>https://pjotrcasteel.github.io/GORM/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pjotrcasteel/GORM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gorm.Tests" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
